# Copy to .env and fill in your Supabase project details.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 public base URL (custom domain or https://<account-id>.r2.dev/<bucket>).
# No trailing slash. Leave blank to use bundled local images.
VITE_R2_PUBLIC_BASE_URL=https://images.your-domain.ss

# R2 object key for the landing hero photo. Leave blank to use /images/hero-market.jpg.
VITE_R2_HERO_KEY=hero-market.jpg
