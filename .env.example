# Browser-visible values (safe to prefix with VITE_). Copy to .env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Cloudflare R2 public base URL (custom domain or https://<account-id>.r2.dev).
# No trailing slash. Leave blank to use bundled local images.
VITE_R2_PUBLIC_BASE_URL=https://images.your-domain.ss

# R2 object key for the landing hero photo. Leave blank to use /images/hero-market.jpg.
VITE_R2_HERO_KEY=hero-market.jpg

# Server-side only. Copy to .env.local (gitignored) and set in Vercel.
# Never add a VITE_ prefix to these keys.
SUPABASE_SECRET_KEY=your-supabase-secret-key
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=FreshPoint <onboarding@resend.dev>
SITE_URL=https://your-domain.example

# R2 upload script credentials (also server-side only).
R2_ACCOUNT_ID=your-account-id
R2_BUCKET=freshpoint
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
